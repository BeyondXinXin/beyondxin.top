---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { toBlogSlug } from '~/utils/blog'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map((post) => ({
    params: { slug: toBlogSlug(post.id) },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const publishedAt = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout title={post.data.title} description={`${post.data.title}｜Beyond欣的博客`}>
  <article class="blog-article">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>{publishedAt}</time>
    </header>
    <div class="blog-prose">
      <Content />
    </div>
  </article>
</BaseLayout>
