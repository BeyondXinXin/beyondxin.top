---
import { site } from '~/config'

const pathname = Astro.url.pathname
---

<header class="site-header">
  <a class="site-logo" href="/" aria-label={`${site.name} 首页`}>Beyond Xin</a>

  <nav class="site-nav" aria-label="主导航">
    <a href="/blog/">博客</a>
    <a href="/projects/" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}>
      作品集
    </a>
    <span class="site-nav__divider" aria-hidden="true"></span>
    <a class="icon-link" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.61-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 7.68a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
      </svg>
    </a>
    <a class="icon-link" href={site.bilibili} target="_blank" rel="noreferrer" aria-label="哔哩哔哩">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m8 3 2.2 3M16 3l-2.2 3M5.5 7h13A2.5 2.5 0 0 1 21 9.5v8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-8A2.5 2.5 0 0 1 5.5 7ZM8 12v3m8-3v3" />
      </svg>
    </a>
  </nav>
</header>
