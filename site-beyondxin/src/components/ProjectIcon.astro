---
import type { ProjectIcon } from '~/data/projects'

interface Props {
  name: ProjectIcon
}

const { name } = Astro.props
---

<svg class="project-icon" viewBox="0 0 48 48" aria-hidden="true">
  {
    name === 'robot' && (
      <>
        <path d="M11 39h12l-2.5-17h-7zM17 22l7-9 8 4 6-6" />
        <circle cx="24" cy="13" r="2.5" />
        <circle cx="32" cy="17" r="2.5" />
        <circle cx="38" cy="11" r="2.5" />
      </>
    )
  }
  {
    name === 'box' && (
      <>
        <path d="m24 5 15 9v19l-15 9-15-9V14zM9 14l15 9 15-9M24 23v19" />
      </>
    )
  }
  {
    name === 'medical' && (
      <>
        <rect x="7" y="8" width="34" height="32" rx="2" />
        <path d="M24 16v16M16 24h16" />
      </>
    )
  }
  {
    name === 'monitor' && (
      <>
        <rect x="6" y="8" width="36" height="27" rx="2" />
        <path d="M18 41h12M24 35v6" />
      </>
    )
  }
  {
    name === 'window' && (
      <>
        <rect x="6" y="7" width="36" height="34" rx="1" />
        <path d="M6 15h36M13 11h.1M18 11h.1" />
      </>
    )
  }
  {
    name === 'file' && (
      <>
        <path d="M12 5h16l9 9v29H12zM28 5v10h9M18 24h13M18 30h13M18 36h8" />
      </>
    )
  }
  {
    name === 'share' && (
      <>
        <circle cx="10" cy="24" r="4" />
        <circle cx="36" cy="9" r="4" />
        <circle cx="36" cy="39" r="4" />
        <path d="m14 22 18-11M14 26l18 11" />
      </>
    )
  }
  {
    name === 'type' && (
      <>
        <path d="M6 10h16M14 10v28M9 38h10M26 18h16M34 18v20M29 38h10" />
      </>
    )
  }
  {
    name === 'palette' && (
      <>
        <path d="M25 6C14 6 6 14 6 24s7 18 16 18c4 0 5-2 4-5-1-4 2-7 6-7h4c4 0 6-3 6-7C42 13 34 6 25 6Z" />
        <circle cx="15" cy="20" r="1.5" /><circle cx="20" cy="13" r="1.5" /><circle cx="29" cy="13" r="1.5" /><circle cx="35" cy="19" r="1.5" />
      </>
    )
  }
  {
    name === 'git' && (
      <>
        <path d="m7 24 17-17 17 17-17 17zM16 15l17 17" />
        <circle cx="16" cy="15" r="2.5" /><circle cx="33" cy="32" r="2.5" /><circle cx="24" cy="24" r="2.5" />
      </>
    )
  }
  {
    name === 'music' && (
      <>
        <path d="M18 35V11l21-5v24M18 16l21-5" />
        <circle cx="12" cy="37" r="6" /><circle cx="33" cy="32" r="6" />
      </>
    )
  }
  {
    name === 'ai' && (
      <>
        <circle cx="24" cy="24" r="7" />
        <path d="M24 5c7 0 9 8 5 13M43 24c0 7-8 9-13 5M24 43c-7 0-9-8-5-13M5 24c0-7 8-9 13-5M10 11c5-5 12-1 12 5M37 10c5 5 1 12-5 12M38 37c-5 5-12 1-12-5M11 38c-5-5-1-12 5-12" />
      </>
    )
  }
  {
    name === 'leaf' && (
      <>
        <path d="M39 7C21 8 10 17 10 29c0 7 5 11 11 11 12 0 19-12 18-33ZM10 40c5-10 12-17 23-25" />
      </>
    )
  }
</svg>
